---
import Base from '../../layouts/Base.astro'; import {publishedBlog,publishedNotes,slug} from '../../lib'; const posts=await publishedBlog(); const notes=await publishedNotes(); const all=[...posts.map(e=>({...e,type:'blog'})),...notes.map(e=>({...e,type:'notes'}))]; const categories=[...new Set(all.map(e=>e.data.category))].sort();
---
<Base title="Knowledge base" description="Explore engineering articles and notes by topic."><div class="container page"><div class="page-heading"><div class="eyebrow">THE KNOWLEDGE BASE</div><h1>A map for the <em>curious.</em></h1><p>Ideas are more useful when they connect. Explore articles and notes organized by topic, all in one place.</p></div><div class="knowledge-layout"><aside><div class="eyebrow">JUMP TO A TOPIC</div>{categories.map(c=><a href={`#${slug(c)}`}>{c} <span>↗</span></a>)}</aside><div>{categories.map((category,i)=><section class="knowledge-group" id={slug(category)}><div class="knowledge-title"><div><span>0{i+1} / TOPIC</span><h2>{category}</h2></div><span>{all.filter(e=>e.data.category===category).length} ENTRIES</span></div>{[...new Set(all.filter(e=>e.data.category===category).flatMap(e=>e.data.tags))].sort().map(tag=><div class="topic-group"><h3>{tag}</h3>{all.filter(e=>e.data.category===category&&e.data.tags.includes(tag)).map(e=><a href={`/${e.type}/${e.id}/`}><span>{e.data.title}</span><small>{e.type==='blog'?'ARTICLE':'NOTE'} ↗</small></a>)}</div>)}</section>)}</div></div></div></Base>
