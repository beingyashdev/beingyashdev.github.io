---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { publishedBlog } from '../lib';

const posts = await publishedBlog();
---

<Base title="Home" description="Technical articles by Yash Sontakke on software engineering, Java, and distributed systems.">
  <div class="container page">
    <header class="page-heading">
      <div class="eyebrow">YASH SONTAKKE / THE WRITING</div>
      <h1>Ideas, <em>unpacked.</em></h1>
      <p>Software engineering, systems, and the things I learn along the way.</p>
    </header>
    <section aria-label="Published articles">
      <div class="list-toolbar">
        <span>{String(posts.length).padStart(2, '0')} ARTICLES</span>
        <a href="/blog/">Browse writing ↗</a>
      </div>
      <EntryList entries={posts} />
    </section>
  </div>
</Base>
