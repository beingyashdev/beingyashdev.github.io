---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { site, projects } from '../config';
import { publishedBlog, publishedNotes } from '../lib';
const posts = await publishedBlog(); const notes = await publishedNotes();
---
<Base><div class="container"><section class="hero"><div class="hero-copy"><div class="eyebrow"><span class="status-dot"></span> A SPACE FOR BUILDING & LEARNING</div><h1>Building software.<br/>Understanding systems.<br/><em>Sharing what I learn.</em></h1><p>{site.bio}</p><div class="hero-actions"><a class="button primary" href="/blog/">Explore the writing <span>↗</span></a><a class="text-link" href="/about/">More about me <span>→</span></a></div><div class="hero-social"><span>FIND ME ON</span><a href={site.github}>GitHub ↗</a>{site.linkedin && <a href={site.linkedin}>LinkedIn ↗</a>}{site.resume && <a href={site.resume}>Resume ↗</a>}</div></div><div class="hero-aside" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit-core"><span>Y / S</span><small>ALWAYS<br/>LEARNING</small></div><span class="aside-label label-one">IDEAS → SYSTEMS</span><span class="aside-label label-two">EST. IN CURIOSITY</span><span class="aside-cross">✳</span></div></section><div class="ticker"><span>SOFTWARE ENGINEERING</span><i>✳</i><span>SYSTEM DESIGN</span><i>✳</i><span>CONTINUOUS LEARNING</span><i>✳</i><span>THOUGHTFUL BUILDING</span></div><section class="section"><div class="section-head"><div><div class="eyebrow">01 / THE WRITING</div><h2>Ideas, unpacked<span class="accent">.</span></h2><p>Longer reads about the systems and concepts behind the code.</p></div><a class="text-link" href="/blog/">All articles <span>↗</span></a></div><EntryList entries={posts.filter(p=>p.data.featured).slice(0,3)} /></section><section class="section split-section"><div><div class="eyebrow">02 / THE NOTEBOOK</div><h2>Small things,<br/><em>worth keeping.</em></h2><p class="section-intro">Not every discovery needs an essay. These are the useful details, questions, and reminders collected along the way.</p><a class="text-link" href="/notes/">Browse learning notes <span>↗</span></a></div><div class="note-stack">{notes.slice(0,3).map(n=><a href={`/notes/${n.id}/`} class="mini-note"><span>{n.data.category}</span><strong>{n.data.title}</strong><b>↗</b></a>)}</div></section><section class="section"><div class="section-head"><div><div class="eyebrow">03 / SELECTED WORK</div><h2>Things in the making<span class="accent">.</span></h2><p>A place for experiments, projects, and ideas brought to life.</p></div><a class="text-link" href="/projects/">All projects <span>↗</span></a></div><div class="project-grid">{projects.filter(p=>p.featured).map((p,i)=><a class="project-card" href="/projects/"><div class="project-top"><span>0{i+1} / SAMPLE PROJECT</span><span>↗</span></div><div class="project-visual"><span>{i===0?'⌘':'✳'}</span></div><h3>{p.name}</h3><p>{p.description}</p><div class="tags">{p.technologies.map(t=><span>{t}</span>)}</div></a>)}</div></section><section class="knowledge-cta"><div><div class="eyebrow">A MAP OF WHAT I’M LEARNING</div><h2>Follow your curiosity<span>.</span></h2><p>Explore connected ideas across Java, system design, and backend engineering.</p></div><a class="button light" href="/knowledge/">Explore the knowledge base ↗</a></section></div></Base>
