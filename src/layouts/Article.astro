---
import Base from './Base.astro'; import { date, readingTime } from '../lib';
const { entry, type, headings, previous, next, related = [], references = [] } = Astro.props;
const isBlog=type==='blog'; const d=entry.data;
---
<Base title={d.title} description={d.description || `A learning note about ${d.title}.`} image={d.cover}><div class="container article-wrap"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href={`/${type}/`}>{isBlog?'Writing':'Notes'}</a><span>/</span><span>{d.category}</span></div><div class="article-heading"><div class="eyebrow">{isBlog?'ARTICLE':'LEARNING NOTE'} / {d.category.toUpperCase()}</div><h1 data-pagefind-meta="title">{d.title}</h1>{d.description && <p>{d.description}</p>}<div class="article-byline"><span>YS</span><div><strong>Yash Sontakke</strong><small>{date(isBlog?d.publishedDate:d.date)} {d.updatedDate && ` · Updated ${date(d.updatedDate)}`} · {readingTime(entry.body)} min read</small></div></div>{d.sample && <p class="sample-label">Sample content · Replace or expand this piece with your own perspective.</p>}</div><div class="article-grid"><article class="prose" data-pagefind-body><span hidden data-pagefind-filter="category">{d.category}</span>{d.tags.map((tag:string)=><span hidden data-pagefind-filter="tag">{tag}</span>)}<slot/>{references.length>0 && <section><h2>References</h2><ul>{references.map((r:any)=><li><a href={r.url}>{r.title}</a></li>)}</ul></section>}</article><aside class="article-aside"><div class="aside-sticky"><div class="eyebrow">ON THIS PAGE</div><nav aria-label="Table of contents">{headings.filter((h:any)=>h.depth===2 || h.depth===3).map((h:any)=><a class:list={[h.depth===3&&'subheading']} href={`#${h.slug}`}>{h.text}</a>)}</nav><div class="aside-tags"><div class="eyebrow">TOPICS</div>{d.tags.map((t:string)=><a href="/knowledge/">#{t}</a>)}</div></div></aside></div>{related.length>0 && <div class="related"><div class="eyebrow">KEEP EXPLORING</div><h2>Related reading<span class="accent">.</span></h2>{related.map((r:any)=><a href={`/blog/${r.id}/`}>{r.data.title} <span>↗</span></a>)}</div>}{isBlog && <div class="article-navigation">{previous?<a href={`/blog/${previous.id}/`}><small>← PREVIOUS</small><strong>{previous.data.title}</strong></a>:<span/>}{next && <a href={`/blog/${next.id}/`}><small>NEXT →</small><strong>{next.data.title}</strong></a>}</div>}</div><script>document.querySelectorAll('.prose pre').forEach((pre)=>{if(pre.querySelector('code')?.classList.contains('language-mermaid'))return;const button=document.createElement('button');button.className='copy-code';button.type='button';button.textContent='Copy';button.setAttribute('aria-label','Copy code');pre.append(button);button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(pre.querySelector('code')?.textContent||'');button.textContent='Copied';setTimeout(()=>button.textContent='Copy',2000)}catch{button.textContent='Unable to copy'}})});</script><script>const diagrams=document.querySelectorAll('pre:has(code.language-mermaid)');if(diagrams.length){import('mermaid').then(async({default:mermaid})=>{mermaid.initialize({startOnLoad:false,securityLevel:'strict',theme:document.documentElement.dataset.theme==='dark'?'dark':'default'});for(const [i,pre] of [...diagrams].entries()){const source=pre.querySelector('code')?.textContent||'';try{const {svg}=await mermaid.render(`diagram-${i}`,source);const div=document.createElement('div');div.className='diagram';div.innerHTML=svg;pre.replaceWith(div)}catch{/* Keep source visible if rendering fails. */}}})}</script></Base>
