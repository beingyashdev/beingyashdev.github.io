---
import '../styles/global.css';
import { site } from '../config';

const { title, description = site.description, image } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.owner} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f8f5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="BeingYashDev RSS" href="/rss.xml" />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="BeingYashDev home">
          <span class="brand-mark">y<span>.</span></span>
          <span>beingyash<span class="brand-muted">dev</span></span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
          <a href="/blog/" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Writing</a>
        </nav>
        <div class="header-actions">
          <a class="icon-button search-link" href="/blog/#search" aria-label="Search articles">⌕</a>
          <button class="icon-button theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle color theme">◐</button>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <a class="brand" href="/"><span class="brand-mark">y<span>.</span></span> beingyash<span class="brand-muted">dev</span></a>
          <p>Engineering articles by {site.owner}.</p>
        </div>
        <div class="footer-links"><a href="/blog/">Writing</a><a href="/rss.xml">RSS</a></div>
      </div>
      <div class="footer-bottom">© {new Date().getFullYear()} {site.owner}<span>Made for curious minds.</span></div>
    </footer>
    <script>
      document.querySelector<HTMLButtonElement>('.theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
      document.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          location.href = '/blog/#search';
        }
      });
    </script>
  </body>
</html>
